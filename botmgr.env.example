# Copy this file to /etc/botmgr.env and edit the token before enabling botmgr.service.
# Generate a strong token with:  openssl rand -hex 32

BOTMGR_HOST=0.0.0.0
BOTMGR_PORT=28473
BOTMGR_TOKEN=replace-me-with-the-output-of-openssl-rand-hex-32

# Uvicorn's per-request access log is off by default so the dashboard's
# background polling doesn't constantly scroll the terminal. Set to 1 when
# you're debugging routing/auth and want the request-by-request stream.
#BOTMGR_ACCESS_LOG=0
